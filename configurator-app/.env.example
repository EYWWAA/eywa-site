# Server secrets only. Never use NEXT_PUBLIC_ for a secret.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-6-astra
# Photo director: gpt-6-astra; image tool: gpt-image-2.5-sunburst (fixed in photo-direction.ts)
# Private actual bar photograph; never committed or served by the public site.
EYWA_BAR_REFERENCE_FILE=./data/eywa-bar-reference.jpg
EYWA_ADMIN_TOKEN=
EYWA_DATA_DIR=./data
EYWA_ALLOWED_ORIGINS=https://eywwaa.github.io
# Only enable when the reverse proxy has replaced the client IP safely.
EYWA_TRUST_PROXY=false
EYWA_DAILY_GENERATION_LIMIT=20
EYWA_CACHE_DAYS=30
# Must be set for hosted API asset URLs, e.g. https://configurator.example.com
EYWA_PUBLIC_API_ORIGIN=
# Enable after the private original bar photo, API account and persistent storage are configured.
EYWA_LIVE_ENABLED=false
# Public frontend destination, embedded at build time (not a secret).
EYWA_SITE_URL=https://eywwaa.github.io/eywa-site/
